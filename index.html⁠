<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ADD.Zd - Private Link Creator</title>
    <link rel="stylesheet" href="style.css">
    <link rel="manifest" href="manifest.json">
</head>
<body>
    <div class="app-container">
        <header>
            <h1>WPP Private Link Creator</h1>
            <p>ADD.Zd</p>
        </header>

        <section class="generator-box">
            <h2>Create Private Conversation Link</h2>
            
            <label>User Profile Photo</label>
            <div class="photo-upload">
                <input type="file" id="photoInput" accept="image/*">
                <div class="icon-edit">✎</div>
            </div>

            <label>Pseudo/Name:</label>
            <input type="text" id="nom" placeholder="Ex: IB GAUCHER">

            <label>WhatsApp Number:</label>
            <input type="tel" id="numero" placeholder="+225 0103 5525 88">

            <label>Private Message / Description:</label>
            <textarea id="desc" placeholder="Salut la famille! ..."></textarea>

            <button onclick="generer()" class="btn-main">GENERATE & SHARE PRIVATE LINK ➔</button>
        </section>

        <div id="resultat" class="result-box" style="display:none;">
            <a id="lienWhatsApp" target="_blank">Click to Open Private WhatsApp Chat</a>
        </div>
    </div>
    <script src="app.js"></script>
    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js');
            });
        }
    </script>
</body>
</html>
