<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>N-D_bot👿 Collecteur</title>
    <link rel="manifest" href='data:application/manifest+json,{"name":"N-D_bot👿 Form","short_name":"N-D_bot","start_url":"./index.html","display":"standalone","background_color":"#ffffff","icons":[{"src":"https://i.ibb.co/HpVYdC9y/logo.png","sizes":"512x512","type":"image/png"}]}'>
    <style>
        body { font-family: sans-serif; padding: 20px; max-width: 500px; margin: auto; background: #f4f4f9; }
        .card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        input, textarea { width: 100%; margin: 10px 0; padding: 10px; border: 1px solid #ccc; border-radius: 6px; box-sizing: border-box; }
        button { width: 100%; padding: 12px; background: #25D366; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; }
        img#preview { max-width: 100%; margin-top: 10px; display: none; border-radius: 6px; }
    </style>
</head>
<body>

<div class="card">
    <h2>N-D_bot👿 Form</h2>
    <input type="file" id="photo" accept="image/*" onchange="previewFile()">
    <img id="preview" alt="Prévisualisation">
    <input type="text" id="nom" placeholder="Nom">
    <input type="tel" id="numero" placeholder="Numéro WhatsApp (ex: 2250700000000)">
    <textarea id="message" placeholder="Description / Message"></textarea>
    <button onclick="genererWhatsApp()">Envoyer sur WhatsApp</button>
</div>

<script>
    function previewFile() {
        const file = document.getElementById('photo').files[0];
        const preview = document.getElementById('preview');
        const reader = new FileReader();
        reader.onloadend = () => { preview.src = reader.result; preview.style.display = 'block'; }
        if (file) reader.readAsDataURL(file);
    }

    function genererWhatsApp() {
        const nom = document.getElementById('nom').value;
        const numero = document.getElementById('numero').value.replace(/\D/g, '');
        const message = document.getElementById('message').value;
        
        if (!numero) { alert("Veuillez entrer un numéro valide."); return; }
        
        const texteFinal = `Nom: ${nom}%0A%0AMessage: ${message}`;
        window.open(`https://wa.me/${numero}?text=${texteFinal}`, '_blank');
    }

    // Service Worker pour PWA
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('data:text/javascript,self.addEventListener("fetch",()=>{});');
    }
</script>

</body>
</html>
