function generer() {
    const nom = document.getElementById('nom').value;
    const numero = document.getElementById('numero').value.replace(/\D/g, ''); 
    const desc = document.getElementById('desc').value;
    
    if(!nom || !numero) return alert("Remplis le nom et le numéro !");

    const message = `Salut la famille ! Moi c'est ${nom}. ${desc}`;
    const url = `https://wa.me/${numero}?text=${encodeURIComponent(message)}`;
    
    const lien = document.getElementById('lienWhatsApp');
    document.getElementById('resultat').style.display = "block";
    lien.href = url;
    lien.innerText = "Clique ici pour envoyer le message";
}

document.getElementById('photoInput').addEventListener('change', function(e) {
    const reader = new FileReader();
    reader.onload = function(event) {
        const preview = document.createElement('img');
        preview.src = event.target.result;
        preview.style.width = "100px"; preview.style.height = "100px";
        preview.style.borderRadius = "50%"; preview.style.objectFit = "cover";
        const container = document.querySelector('.photo-upload');
        const oldImg = container.querySelector('img');
        if(oldImg) container.removeChild(oldImg);
        container.appendChild(preview);
    };
    reader.readAsDataURL(e.target.files[0]);
});
