body { background-color: #0b141a; color: white; font-family: sans-serif; margin: 0; padding: 20px; }
.app-container { max-width: 450px; margin: auto; }
.generator-box { background-color: #1f2c34; padding: 20px; border-radius: 15px; }
input, textarea { width: 100%; background: #2a3942; border: none; padding: 12px; margin: 10px 0; color: white; border-radius: 8px; box-sizing: border-box; }
.btn-main { width: 100%; background: #00a884; border: none; padding: 15px; color: white; font-weight: bold; border-radius: 8px; cursor: pointer; margin-top: 10px; }
.result-box { margin-top: 20px; padding: 15px; background: #005c4b; border-radius: 8px; text-align: center; }
a { color: white; text-decoration: none; font-weight: bold; }
.photo-upload { text-align: center; margin: 10px 0; }
